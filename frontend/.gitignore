# ─── Dependencies ────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/
.pnp.*

# ─── Build output ────────────────────────────────────────────────
dist/
dist-ssr/
build/
*.local

# ─── Environment variables ───────────────────────────────────────
